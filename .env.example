# Copy to .env and fill in. These secrets are REQUIRED in production (the app refuses to boot
# without 32+ char values). The values below are placeholders — generate real ones.
AUDIO_AUTH_SECRET=change-me-auth-0123456789abcdef0123456789abcdef
AUDIO_CAPABILITY_SECRET=change-me-cap-0123456789abcdef0123456789abcdef
AUDIO_WATERMARK_SECRET=change-me-wm-0123456789abcdef0123456789abcdef
AUDIO_SEGMENT_KEY_SECRET=change-me-key-0123456789abcdef0123456789abcdef

# Optional: Cloudflare R2 / S3 object storage (leave blank to use local disk in the container).
AUDIO_OBJECT_STORE_BACKEND=local
AUDIO_OBJECT_STORE_BUCKET=
AUDIO_OBJECT_STORE_ENDPOINT=
AUDIO_OBJECT_STORE_ACCESS_KEY=
AUDIO_OBJECT_STORE_SECRET_KEY=

# Optional: when serving segments via Cloudflare (not the in-container /v1/cdn dev path).
AUDIO_CDN_BASE_URL=
